# Copy to .env. Without overrides, docker compose uses its local Postgres container.

# Hosted Supabase: Dashboard > Connect > Session pooler (port 5432), with your database password
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Part B. Optional: without a key the committed signal snapshot is used.
# OPENAI_API_KEY=
# OPENAI_MODEL=
